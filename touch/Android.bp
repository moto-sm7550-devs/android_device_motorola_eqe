cc_binary {
    name: "vendor.lineage.touch-service.eqe",
    vintf_fragments: ["vendor.lineage.touch-service.eqe.xml"],
    init_rc: ["vendor.lineage.touch-service.eqe.rc"],
    relative_install_path: "hw",
    proprietary: true,
    srcs: [
        "HighTouchPollingRate.cpp",
        "TouchscreenGesture.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libutils",
        "vendor.lineage.touch-V1-ndk",
    ],
}
